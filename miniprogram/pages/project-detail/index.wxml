<!-- Empty and selected-day copy must describe the actual record scope, independently of full-history expansion. -->
<app-navigation
  id="detail-navigation"
  title="{{showNavTitle?project.name:''}}"
  show-back
  bind:layout="navLayout"
/>
<view class="page-content detail" style="--accent:{{color}}">
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:if="{{error}}" class="error" aria-role="alert">
    {{error}}
    <button class="link" bindtap="load">重试</button>
  </view>
  <block wx:if="{{project}}">
    <view class="detail-heading">
      <view class="project-badge"><ui-icon name="{{project.icon}}" tone="white" size="24" /></view>
      <text class="project-title">{{project.name}}</text>
      <!-- This neutral badge explains the default scope without implying a completion target. -->
      <text class="frequency-badge">{{frequencyLabel}}</text>
    </view>
    <view class="lifetime-caption">{{summaries[0].label}}</view>
    <view class="lifetime-number {{summaries[0].number.length>12?'long':''}}">
      <text>{{summaries[0].number}}</text>
      <text class="lifetime-unit">{{summaries[0].unit}}</text>
    </view>
    <!-- Visible metrics include historical values from disabled types; only a genuine single-metric detail drops this row. -->
    <view wx:if="{{metrics.length>1}}" class="lifetime-secondary">{{secondarySummary}}</view>
    <view class="metric-tabs" wx:if="{{metrics.length>1}}">
      <button
        wx:for="{{metrics}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="metric"
        class="metric-tab {{metric===item.id?'active':''}}"
        aria-pressed="{{metric===item.id}}"
        hover-class="pressed"
      >
        <text>{{item.label}}</text>
      </button>
    </view>
    <view class="chart-card {{metrics.length===1?'single-metric':''}}">
      <!-- Lead with long-term accumulation, then period distribution and date-based review. -->
      <view class="chart-mode">
        <button
          class="mode-hit"
          data-mode="cumulative"
          bindtap="mode"
          aria-pressed="{{chartMode==='cumulative'}}"
          hover-class="pressed"
        >
          <text class="mode-pill {{chartMode==='cumulative'?'active':''}}">累计</text>
        </button>
        <button
          class="mode-hit"
          data-mode="distribution"
          bindtap="mode"
          aria-pressed="{{chartMode==='distribution'}}"
          hover-class="pressed"
        >
          <text class="mode-pill {{chartMode==='distribution'?'active':''}}">分布</text>
        </button>
        <button
          class="mode-hit"
          data-mode="calendar"
          bindtap="mode"
          aria-pressed="{{chartMode==='calendar'}}"
          hover-class="pressed"
        >
          <text class="mode-pill {{chartMode==='calendar'?'active':''}}">日历</text>
        </button>
      </view>
      <!-- Calendar cells are ordinary views, so page scrolling and native sheets never compete with a canvas layer. -->
      <view wx:if="{{chartMode==='calendar'}}" class="statistics-body calendar-body">
        <view class="date-navigation calendar-navigation">
          <button
            bindtap="calendarMonth"
            data-delta="-1"
            disabled="{{!calendarPrevious}}"
            aria-label="上个月"
            hover-class="pressed"
          >
            <ui-icon name="back" tone="{{project.color}}" size="16" />
          </button>
          <text>{{calendarLabel}}</text>
          <button
            bindtap="calendarMonth"
            data-delta="1"
            disabled="{{!calendarNext}}"
            aria-label="下个月"
            hover-class="pressed"
          >
            <ui-icon name="chevron" tone="{{project.color}}" size="16" />
          </button>
        </view>
        <view class="heat-weekdays" aria-hidden="true">
          <text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
        </view>
        <view
          class="heat-grid"
          style="grid-template-rows:repeat({{calendarRows}},minmax(44px,1fr))"
          aria-role="group"
          aria-label="每日{{metric==='quantity'?'数量':'时间'}}记录日历"
        >
          <button
            wx:for="{{calendarCells}}"
            wx:key="date"
            class="heat-day {{item.level===4?'strong':''}} {{item.disabled?'unavailable':''}}"
            data-date="{{item.date}}"
            bindtap="calendarDay"
            disabled="{{item.disabled}}"
            aria-hidden="{{!item.inside}}"
            aria-pressed="{{calendarDate===item.date}}"
            aria-label="{{item.future?item.date+'，未来日期':item.reading}}"
            hover-class="pressed"
          >
            <view
              class="heat-fill"
              style="background:{{item.disabled?'transparent':item.background}};border-color:{{item.today?color:'transparent'}}"
            ></view>
            <view wx:if="{{calendarDate===item.date}}" class="heat-selection"></view>
            <text>{{item.inside?(item.missing?'—':item.day):''}}</text>
          </button>
        </view>
        <!-- Readout and sharing use the same reserved footer as the other two statistical views. -->
        <view class="calendar-footer">
          <view class="calendar-reading" aria-role="status">{{calendarReading}}</view>
        </view>
      </view>
      <view wx:else class="statistics-body standard-body">
        <view class="period-options">
          <button
            wx:for="{{periods}}"
            wx:key="id"
            class="period-hit"
            bindtap="period"
            data-id="{{item.id}}"
            aria-pressed="{{period===item.id}}"
            hover-class="pressed"
          >
            <text class="period-pill {{period===item.id?'active':''}}">{{item.label}}</text>
          </button>
        </view>
        <view class="date-navigation">
          <button
            bindtap="previous"
            disabled="{{period==='all'}}"
            aria-label="{{period==='week'?'上一周':period==='month'?'上个月':'上一年'}}"
            hover-class="pressed"
          >
            <ui-icon name="back" tone="{{project.color}}" size="16" />
          </button>
          <text>{{periodLabel}}</text>
          <button
            bindtap="next"
            disabled="{{period==='all' || offset>=0}}"
            aria-label="{{period==='week'?'下一周':period==='month'?'下个月':'下一年'}}"
            hover-class="pressed"
          >
            <ui-icon name="chevron" tone="{{project.color}}" size="16" />
          </button>
        </view>
        <practice-chart
          id="practice-chart"
          class="standard-chart"
          points="{{points}}"
          mode="{{chartMode}}"
          factor="{{factor}}"
          unit="{{unit}}"
          color="{{color}}"
          baseline="{{baseline}}"
          is-time="{{metric === 'durationSeconds'}}"
          obscured="{{sheetOpen}}"
          focus-baseline="{{period!=='all'}}"
          bind:share="share"
        />
      </view>
      <!-- One corner action serves all chart modes and stays clear of the reserved left readout. -->
      <button
        class="statistics-share"
        bindtap="share"
        aria-label="分享当前统计"
        hover-class="pressed"
      >
        <text class="share-corner" style="background:{{color}}16;color:{{color}}">分享</text>
      </button>
    </view>
    <view
      id="record-section"
      class="record-heading {{expanded?'sticky':''}}"
      style="top:{{navHeight}}px"
    >
      <!-- Native text preserves source newlines; a single-line label keeps both header baselines aligned. -->
      <!-- prettier-ignore -->
      <text class="record-heading-title">{{chartMode==='calendar' && calendarDate && !expanded?calendarDateLabel+'的记录':'打卡记录'}}</text>
      <button
        wx:if="{{chartMode==='calendar' && calendarDate && !expanded}}"
        class="link"
        bindtap="calendarClear"
        hover-class="pressed"
      >
        <text>查看本月</text>
      </button>
      <button wx:if="{{expanded}}" class="link" bindtap="collapse" hover-class="pressed">
        <text>收起</text>
      </button>
    </view>
    <view class="records">
      <view wx:if="{{!records.length}}" class="empty">
        {{expanded?'暂无记录':chartMode==='calendar' &&
        calendarDate?'当天暂无记录':'所选时段暂无记录'}}
      </view>
      <button
        wx:for="{{records}}"
        wx:key="id"
        class="record-row"
        bindtap="editRecord"
        bindlongpress="recordMenu"
        data-id="{{item.id}}"
        hover-class="pressed"
        aria-label="编辑{{item.date}}记录，{{item.value}}"
      >
        <view class="record-content">
          <view class="record-value">{{item.value}}</view>
          <view class="record-meta">{{item.meta}}</view>
        </view>
        <ui-icon name="chevron" tone="muted" size="15" />
      </button>
      <button
        wx:if="{{!expanded && (historyCount>5 || selectedCount!==historyCount)}}"
        class="show-all"
        bindtap="expand"
        hover-class="pressed"
      >
        查看全部记录
      </button>
      <button wx:if="{{expanded && hasMore}}" class="show-all" bindtap="more" hover-class="pressed">
        加载更多
      </button>
      <view wx:if="{{expanded && !hasMore && records.length}}" class="end">已显示全部记录</view>
    </view>
    <view class="record-count">
      {{expanded?'已显示 '+records.length+' / ':''}}共 {{expanded?historyCount:selectedCount}}
      条记录
    </view>
    <button class="setting-button" bindtap="settings" hover-class="pressed">
      <text>项目设置</text>
      <ui-icon name="chevron" tone="muted" size="16" />
    </button>
    <button
      class="delete-button"
      bindtap="deleteProject"
      disabled="{{deleting}}"
      loading="{{deleting}}"
      hover-class="pressed"
    >
      删除项目
    </button>
  </block>
</view>
<record-sheet
  id="record-sheet"
  bind:saved="saved"
  bind:closed="sheetClosed"
  bind:deleted="deleted"
/>
<!-- Share the same stable component anchor as home for transient undo-state verification. -->
<undo-toast id="undo-toast" message="{{toast}}" expires-at="{{expiresAt}}" bind:undo="undo" />

<!-- Offscreen export keeps the current page in place; native canvas never joins scrolling content. -->
<canvas id="share-buffer" type="2d" class="share-buffer" aria-hidden="true" />
