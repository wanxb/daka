/* Statistics use full-width, aligned control rows; history grows in the main page scroll. */
.detail {
  padding-top: 8px;
}
.summary {
  display: flex;
  align-items: flex-end;
  gap: 20px;
  margin: 8px 2px 24px;
}
.summary-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.summary-label {
  font-size: 12px;
  color: var(--secondary);
}
.summary-value {
  font-size: 20px;
  letter-spacing: -0.4px;
  font-weight: 500;
  line-height: 1.25;
  overflow-wrap: anywhere;
}
.main .summary-value {
  font-size: 30px;
  font-weight: 600;
  letter-spacing: -0.8px;
}
.chart-card {
  padding: 10px 14px 12px;
}
.metric-tabs {
  display: flex;
  gap: 18px;
  padding: 0 4px 4px;
}
.metric-tabs .metric-tab {
  width: auto;
  min-width: 44px;
  flex: 1;
  margin: 0;
  height: 44px;
  background: none;
  color: var(--secondary);
  font-size: 14px;
  padding: 0 2px;
  line-height: 44px;
}
.metric-tab.active {
  color: var(--accent);
  font-weight: 600;
}
.chart-mode {
  display: flex;
  gap: 4px;
}
.mode-hit {
  flex: 1;
  display: flex;
  align-items: center;
  height: 44px;
  background: none;
}
.mode-pill {
  width: 100%;
  height: 32px;
  line-height: 32px;
  font-size: 14px;
  border-radius: 9px;
  color: var(--secondary);
  background: #f3f2f7;
}
.mode-pill.active {
  background: var(--accent);
  color: #fff;
}
.period-options {
  display: flex;
  gap: 4px;
}
.period-hit {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  background: none;
  min-width: 0;
}
.period-pill {
  width: 100%;
  height: 28px;
  line-height: 28px;
  border-radius: 7px;
  font-size: 13px;
  color: var(--secondary);
}
.period-pill.active {
  background: #efedf7;
  color: var(--accent);
  font-weight: 500;
}
.date-navigation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  margin-top: 8px;
  min-height: 44px;
  color: var(--secondary);
}
.date-navigation > text {
  flex: 1;
  text-align: center;
  font-size: 12px;
}
.chart-card .date-navigation button {
  width: 44px;
  height: 44px;
  line-height: 40px;
  font-size: 26px;
  color: var(--accent);
  background: none;
}
.date-navigation button[disabled] {
  opacity: 0.25;
}
.record-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56px;
  padding: 8px 2px 0;
  font-size: 16px;
  box-sizing: border-box;
  background: #f2f2f7;
}
.record-heading.sticky {
  position: sticky;
  z-index: 10;
}
.record-count {
  font-size: 12px;
  color: var(--secondary);
  margin-left: 8px;
}
.record-heading .link {
  /* The trailing action stays content-sized; style:v2 must not reserve half the heading for it. */
  width: auto;
  margin: 0;
}
.record-row {
  display: flex;
  align-items: center;
  position: relative;
  min-height: 64px;
}
.record-row + .record-row::before {
  content: '';
  position: absolute;
  top: 0;
  left: 14px;
  right: 0;
  height: 1px;
  background: var(--line);
}
.record-row .record-main {
  width: auto;
  display: block;
  flex: 1;
  min-width: 0;
  background: none;
  padding: 14px 0 14px 14px;
  text-align: left;
  line-height: 1.5;
}
.record-top {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 4px 8px;
}
.record-date {
  font-size: 12px;
  color: var(--secondary);
}
.record-value {
  font-size: 14px;
  color: var(--ink);
  overflow-wrap: anywhere;
}
.record-note {
  font-size: 13px;
  color: var(--secondary);
  margin-top: 4px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.record-row .record-menu {
  width: 44px;
  min-height: 56px;
  font-size: 23px;
  background: none;
  color: var(--secondary);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}
.more {
  width: 100%;
}
.end {
  text-align: center;
  padding: 15px;
  font-size: 12px;
  color: var(--secondary);
}
.detail .setting-button {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 54px;
  padding: 0 14px;
  margin-top: 24px;
  background: #fff;
  gap: 10px;
  font-size: 16px;
}
.setting-button text {
  flex: 1;
  text-align: left;
}
.detail .delete-button {
  color: var(--danger);
  background: none;
  font-size: 15px;
  min-height: 48px;
  margin: 12px 0 20px;
  width: 100%;
  line-height: 48px;
}

/* Long totals get a full line; preview notes stay concise and remain fully editable in the record sheet. */
.summary.stacked {
  flex-direction: column;
  align-items: stretch;
  gap: 16px;
}
.summary-value {
  font-variant-numeric: tabular-nums;
}
.main .summary-value.long {
  font-size: 24px;
}
.date-navigation button {
  display: flex;
  align-items: center;
  justify-content: center;
}
.previous-icon {
  transform: rotate(180deg);
  display: flex;
}
.record-note {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
