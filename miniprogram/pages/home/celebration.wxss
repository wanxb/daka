@keyframes celebration-mark-fade {
  0% {
    opacity: 0;
  }
  16%,
  76% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}
@keyframes celebration-ink {
  from {
    clip-path: inset(0 100% 0 0);
  }
  to {
    clip-path: inset(0 0 0 0);
  }
}
/* Reduced motion keeps a static confirmation and existing accessible toast, without moving paper. */
@media (prefers-reduced-motion: reduce) {
  .celebration-paper {
    display: none;
  }
  .celebration-glass,
  .celebration-mark,
  .celebration-ink {
    animation: none;
  }
}
