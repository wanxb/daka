/* Ordinary views scroll/compose safely: no native Canvas layer can cover navigation or record panels. */
.celebration-stage {
  position: fixed;
  inset: 0;
  z-index: 20;
  overflow: hidden;
  pointer-events: none;
}
.celebration-glass {
  position: absolute;
  border-radius: 22px;
  background: #ffffff14;
  border: 1px solid #ffffff30;
  box-sizing: border-box;
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  animation: celebration-mark-fade 2400ms ease-out both;
}
.celebration-mark {
  position: absolute;
  width: 88px;
  height: 88px;
  margin: -44px;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: celebration-mark-fade 2400ms ease-out both;
}
.celebration-ink {
  width: 74px;
  height: 74px;
  /* Reveal the long hook from its rounded beginning toward the tip; completion is purely decorative. */
  animation: celebration-ink 500ms 80ms ease-in-out both;
}
/* A 10px square improves visibility on phones while retaining the approved roll/tilt projection and origin. */
.celebration-paper {
  position: absolute;
  width: 10px;
  height: 10px;
  margin: -5px;
  transform-origin: center;
  animation: celebration-paper 2800ms linear both;
}
/* Forty intervals preserve the early spray and cumulative sway, interpolated entirely by WebView. */
