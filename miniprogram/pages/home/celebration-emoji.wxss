/* Ordinary text views share the paper stage: no Canvas overlay or per-frame bridge traffic. */
.celebration-emoji {
  position: absolute;
  width: 0;
  height: 0;
  transform-origin: 0 0;
  animation: celebration-emoji 2800ms linear both;
}
.celebration-emoji-glyph {
  display: inline-block;
  white-space: nowrap;
  line-height: 40px;
  font-family: 'Apple Color Emoji', 'Segoe UI Emoji', 'Noto Color Emoji', sans-serif;
  color: #ffe08a;
  text-shadow: 0 1px 2px #32234030;
  transform: translate(-50%, -50%);
}
/* Independent frame properties protect the approved paper projection and shading from Emoji changes. */
@keyframes celebration-emoji {
  0% {
    transform: var(--e0);
    opacity: var(--a0);
  }
  2.5% {
    transform: var(--e1);
    opacity: var(--a1);
  }
  5% {
    transform: var(--e2);
    opacity: var(--a2);
  }
  7.5% {
    transform: var(--e3);
    opacity: var(--a3);
  }
  10% {
    transform: var(--e4);
    opacity: var(--a4);
  }
  12.5% {
