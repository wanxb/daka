/* Compact two-column cards preserve the reference proportions; details have an independent 44px hit area. */
.home {
  padding-top: 4px;
}
.search {
  background: #e6e6ed;
  border-radius: 12px;
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 12px;
  gap: 8px;
  margin-bottom: 20px;
}
.search input {
  flex: 1;
  min-width: 0;
  height: 44px;
  font-size: 16px;
}
.tile-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
.tile,
.add-tile {
  width: calc((100% - 12px) / 2);
  height: 88px;
  border-radius: 19px;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  color: #fff;
}
.purple {
  background: linear-gradient(115deg, #7959cf, #6440ba);
}
.orange {
  background: linear-gradient(115deg, #bf5028, #b74221);
}
.blue {
  background: linear-gradient(115deg, #3b6bd1, #2d5dc6);
}
.teal {
  background: linear-gradient(115deg, #087f79, #087c77);
}
.rose {
  background: linear-gradient(115deg, #c44266, #b8385c);
}
.tile-main {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: none;
  color: inherit;
  padding: 0;
  text-align: left;
  line-height: 1.2;
}
.tile-main[disabled] {
  background: none;
  color: inherit;
  opacity: 0.7;
}
.tile-icon {
  position: absolute;
  left: 14px;
  top: 14px;
}
.tile-number {
  position: absolute;
  right: 40px;
  top: 11px;
  display: flex;
  align-items: baseline;
  gap: 2px;
  font-size: 26px;
  line-height: 1.1;
  font-weight: 600;
  letter-spacing: -0.8px;
  font-variant-numeric: tabular-nums;
  max-width: calc(100% - 80px);
}
.tile-number.small {
  font-size: 19px;
  letter-spacing: -0.4px;
}
.tile-unit {
  font-size: 11px;
  letter-spacing: 0;
  flex-shrink: 0;
}
.tile-footer {
  position: absolute;
  left: 14px;
  right: 12px;
  bottom: 12px;
  display: flex;
  align-items: flex-end;
  gap: 4px;
}
.tile-name {
  font-size: 15px;
  font-weight: 500;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tile-caption {
  font-size: 10px;
  line-height: 1.35;
  max-width: 64px;
  text-align: right;
  overflow-wrap: anywhere;
}
.tile-detail {
  position: absolute;
  right: 0;
  top: 0;
  width: 44px;
  height: 44px;
  background: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-disc {
  width: 18px;
  height: 18px;
  background: #ffffff19;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.tile-pressed {
  background: #0000000a;
}
.add-tile {
  background: #e7e6ef;
  color: #675685;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  padding: 13px 14px;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.2;
}
.add-tile.first {
  width: 100%;
  height: 120px;
  padding: 20px;
}
@media (min-width: 600px) {
  .tile,
  .add-tile {
    height: 104px;
  }
  .tile-number {
    font-size: 30px;
  }
}
