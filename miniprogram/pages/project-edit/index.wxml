<!-- The preview placeholder is display-only; it must never become the saved project name. -->
<app-navigation
  title="{{editing?'项目设置':'新增打卡'}}"
  show-back
  custom-back
  back-text="取消"
  bind:back="cancel"
  bind:layout="navigationLayout"
/>
<view class="page-content editor" style="--accent:{{palette[form.color]}}">
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <block wx:elif="{{ready}}">
    <!-- Navigation already identifies this page; content starts directly with the project preview. -->
    <view class="preview {{form.color}}">
      <ui-icon name="{{form.icon}}" tone="white" size="29" />
      <view>
        <text class="preview-name">{{form.name || '打卡名称'}}</text>
        <!-- Native text renders source newlines; keep this short subtitle on one line to preserve the preview alignment. -->
        <!-- prettier-ignore -->
        <text class="preview-mode">{{frequencyNames[form.frequency]}} · {{form.timeEnabled && form.quantityEnabled?'记时间与数量':form.timeEnabled?'记时间':form.quantityEnabled?'记数量':'选择打卡类型'}}</text>
      </view>
    </view>
    <view class="surface name-row">
      <input
        id="editor-name"
        focus="{{focusedField === 'name'}}"
        disabled="{{busy}}"
        value="{{form.name}}"
        data-field="name"
        bindinput="text"
        maxlength="{{limits.projectName*2}}"
        placeholder="打卡名称"
        aria-label="打卡名称"
      />
    </view>
    <view class="section-label">外观样式</view>
    <view class="surface">
      <view class="colors">
        <button
          wx:for="{{colors}}"
          wx:key="id"
          class="color-hit"
          disabled="{{busy}}"
          data-field="color"
          data-value="{{item.id}}"
          bindtap="choose"
          aria-label="{{item.label}}主题色"
          aria-pressed="{{form.color === item.id}}"
          hover-class="pressed"
        >
          <view
            class="swatch {{form.color === item.id?'chosen':''}}"
            style="background:{{item.color}}"
          >
            <ui-icon wx:if="{{form.color === item.id}}" name="check" tone="white" size="18" />
          </view>
        </button>
      </view>
      <view class="icons">
        <button
          wx:for="{{icons}}"
          wx:key="id"
          disabled="{{busy}}"
          class="icon-hit {{form.icon === item.id?'selected':''}}"
          data-field="icon"
          data-value="{{item.id}}"
          bindtap="choose"
          aria-label="{{item.label}}图标"
          aria-pressed="{{form.icon === item.id}}"
          hover-class="pressed"
        >
          <view class="icon-disc {{form.icon === item.id?'selected':''}}">
            <ui-icon
              name="{{item.id}}"
              tone="{{form.icon === item.id?form.color:'muted'}}"
              size="22"
            />
          </view>
        </button>
      </view>
      <!-- Expansion is a view-only control, with the same 44px target as appearance choices. -->
      <button
        class="appearance-more"
        bindtap="toggleAppearance"
        disabled="{{busy}}"
        aria-expanded="{{appearanceExpanded}}"
        hover-class="pressed"
      >
        <text>{{appearanceExpanded?'收起外观':'更多外观'}}</text>
        <view class="appearance-arrow {{appearanceExpanded?'expanded':''}}">
          <ui-icon name="expand" tone="muted" size="16" />
        </view>
      </button>
    </view>
    <view id="editor-types" class="section-label">打卡类型</view>
    <view class="surface config">
      <view class="heading-row metric-heading">
        <ui-icon name="clock" tone="muted" />
        <text>时间</text>
        <switch
          disabled="{{busy}}"
          checked="{{form.timeEnabled}}"
          data-field="timeEnabled"
          bindchange="toggle"
          color="{{palette[form.color]}}"
          aria-label="启用时间记录"
        />
      </view>
      <!-- Mount only the active parameters; their short reveal never delays validation or saving. -->
      <view wx:if="{{form.timeEnabled}}" class="motion-disclosure">
        <view class="parameter row">
          <text>时间单位</text>
          <view class="segments compact">
            <button
              wx:for="{{units}}"
              wx:key="*this"
              disabled="{{busy}}"
              class="segment-hit"
              data-field="timeUnit"
              data-value="{{item}}"
              bindtap="choose"
              aria-pressed="{{form.timeUnit === item}}"
              hover-class="pressed"
            >
              <!-- Keep the full display caption on one native text line; dataset values retain their stored unit keys. -->
              <!-- prettier-ignore -->
              <text class="segment {{form.timeUnit === item?'selected':''}}">{{timeUnitLabels[item]}}</text>
            </button>
          </view>
        </view>
        <view class="parameter row range-row">
          <text>时间范围</text>
          <view class="range">
            <input
              id="editor-timeMin"
              focus="{{focusedField === 'timeMin'}}"
              disabled="{{busy}}"
              type="number"
              value="{{form.timeMin}}"
              style="width:{{form.timeMin.length || 1}}ch"
              data-field="timeMin"
              data-kind="time"
              bindinput="text"
              bindblur="rangeBlur"
              aria-label="时间范围最小值，单位{{timeUnitLabels[form.timeUnit]}}"
              maxlength="{{form.timeMin.length>timeLengths[form.timeUnit]?form.timeMin.length:timeLengths[form.timeUnit]}}"
            />
            <text class="dash">–</text>
            <input
              id="editor-timeMax"
              focus="{{focusedField === 'timeMax'}}"
              disabled="{{busy}}"
              type="number"
              value="{{form.timeMax}}"
              style="width:{{form.timeMax.length || 1}}ch"
              data-field="timeMax"
              data-kind="time"
              bindinput="text"
              bindblur="rangeBlur"
              aria-label="时间范围最大值，单位{{timeUnitLabels[form.timeUnit]}}"
              maxlength="{{form.timeMax.length>timeLengths[form.timeUnit]?form.timeMax.length:timeLengths[form.timeUnit]}}"
            />
          </view>
        </view>
        <view class="parameter row">
          <text>默认时间</text>
          <input
            id="editor-defaultTime"
            focus="{{focusedField === 'defaultTime'}}"
            disabled="{{busy}}"
            type="number"
            value="{{form.defaultTime}}"
            data-field="defaultTime"
            data-kind="time"
            bindinput="text"
            bindblur="defaultBlur"
            bindconfirm="defaultBlur"
            confirm-type="done"
            aria-label="默认时间，单位{{timeUnitLabels[form.timeUnit]}}"
            maxlength="{{form.defaultTime.length>timeLengths[form.timeUnit]?form.defaultTime.length:timeLengths[form.timeUnit]}}"
          />
        </view>
      </view>
      <view class="heading-row metric-heading separator">
        <ui-icon name="quantity" tone="muted" />
        <text>数量</text>
        <switch
          disabled="{{busy}}"
          checked="{{form.quantityEnabled}}"
          data-field="quantityEnabled"
          bindchange="toggle"
          color="{{palette[form.color]}}"
          aria-label="启用数量记录"
        />
      </view>
      <view wx:if="{{form.quantityEnabled}}" class="motion-disclosure">
        <view class="parameter row">
          <text>数量单位</text>
          <view class="unit-value">
            <input
              id="editor-quantityUnit"
              focus="{{focusedField === 'quantityUnit'}}"
              value="{{form.quantityUnit}}"
              style="width:{{form.quantityUnit.length || 1}}em"
              data-field="quantityUnit"
              bindinput="text"
              disabled="{{busy || locked}}"
              maxlength="{{limits.quantityUnit*2}}"
              aria-label="数量单位{{locked?'，已有记录，不可更改':''}}"
            />
          </view>
        </view>
        <view class="parameter row range-row">
          <text>数量范围</text>
          <view class="range">
            <input
              id="editor-quantityMin"
              focus="{{focusedField === 'quantityMin'}}"
              disabled="{{busy}}"
              type="number"
              value="{{form.quantityMin}}"
              style="width:{{form.quantityMin.length || 1}}ch"
              data-field="quantityMin"
              data-kind="quantity"
              bindinput="text"
              bindblur="rangeBlur"
              aria-label="数量范围最小值，单位{{form.quantityUnit}}"
              maxlength="{{form.quantityMin.length>5?form.quantityMin.length:5}}"
            />
            <text class="dash">–</text>
            <input
              id="editor-quantityMax"
              focus="{{focusedField === 'quantityMax'}}"
              disabled="{{busy}}"
              type="number"
              value="{{form.quantityMax}}"
              style="width:{{form.quantityMax.length || 1}}ch"
              data-field="quantityMax"
              data-kind="quantity"
              bindinput="text"
              bindblur="rangeBlur"
              aria-label="数量范围最大值，单位{{form.quantityUnit}}"
              maxlength="{{form.quantityMax.length>5?form.quantityMax.length:5}}"
            />
          </view>
        </view>
        <view class="parameter row">
          <text>默认数量</text>
          <input
            id="editor-defaultQuantity"
            focus="{{focusedField === 'defaultQuantity'}}"
            disabled="{{busy}}"
            type="number"
            value="{{form.defaultQuantity}}"
            data-field="defaultQuantity"
            data-kind="quantity"
            bindinput="text"
            bindblur="defaultBlur"
            bindconfirm="defaultBlur"
            confirm-type="done"
            aria-label="默认数量，单位{{form.quantityUnit}}"
            maxlength="{{form.defaultQuantity.length>5?form.defaultQuantity.length:5}}"
          />
        </view>
      </view>
      <!-- Cadence belongs above primary metric; changing it never alters measurement configuration. -->
      <view class="heading-row separator">
        <ui-icon name="clock" tone="muted" size="18" />
        <text>打卡频率</text>
        <view class="segments frequency-options" aria-label="打卡频率">
          <button
            wx:for="{{frequencies}}"
            wx:key="id"
            class="segment-hit"
            disabled="{{busy}}"
            data-field="frequency"
            data-value="{{item.id}}"
            bindtap="choose"
            aria-label="{{item.label==='日'?'每日':item.label==='周'?'每周':'每月'}}"
            aria-pressed="{{form.frequency === item.id}}"
            hover-class="pressed"
          >
            <text class="segment {{form.frequency === item.id?'selected':''}}">{{item.label}}</text>
          </button>
        </view>
      </view>

      <view class="heading-row separator">
        <ui-icon name="chart" tone="muted" />
        <text>主要指标</text>
        <view class="segments primary-options">
          <button
            class="segment-hit"
            data-field="primaryMetric"
            data-value="durationSeconds"
            bindtap="choose"
            disabled="{{busy || !form.timeEnabled}}"
            aria-pressed="{{(form.timeEnabled && !form.quantityEnabled) || (form.primaryMetric === 'durationSeconds' && form.timeEnabled)}}"
          >
            <!-- Native text preserves newlines as real line breaks; keep these short pill labels inline. -->
            <!-- prettier-ignore -->
            <text class="segment {{(form.timeEnabled && !form.quantityEnabled) || (form.primaryMetric === 'durationSeconds' && form.timeEnabled)?'selected':''}}">时间</text>
          </button>
          <button
            class="segment-hit"
            data-field="primaryMetric"
            data-value="quantity"
            bindtap="choose"
            disabled="{{busy || !form.quantityEnabled}}"
            aria-pressed="{{(form.quantityEnabled && !form.timeEnabled) || (form.primaryMetric === 'quantity' && form.quantityEnabled)}}"
          >
            <!-- prettier-ignore -->
            <text class="segment {{(form.quantityEnabled && !form.timeEnabled) || (form.primaryMetric === 'quantity' && form.quantityEnabled)?'selected':''}}">数量</text>
          </button>
        </view>
      </view>
      <view class="heading-row separator">
        <ui-icon name="bolt" tone="muted" />
        <text>快速打卡</text>
        <switch
          disabled="{{busy}}"
          checked="{{form.directEntryEnabled}}"
          data-field="directEntryEnabled"
          bindchange="toggle"
          color="{{palette[form.color]}}"
          aria-label="快速打卡，轻点卡片按默认值保存记录"
        />
      </view>
    </view>
    <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
    <!-- Disclose local-only retention before creation; settings reuse this page without repeating onboarding copy. -->
    <view wx:if="{{!editing}}" class="storage-notice">
      数据仅保存在本机，不支持换机同步。清除小程序数据会丢失记录。
    </view>
    <!-- Available actions guide incomplete forms to the relevant input; only busy storage disables interaction. -->
    <button
      class="primary save"
      bindtap="save"
      loading="{{busy}}"
      disabled="{{busy}}"
      hover-class="pressed"
    >
      {{editing?'保存设置':'创建打卡'}}
    </button>
  </block>
  <view wx:if="{{!loading && !ready}}" class="error" aria-role="alert">
    {{error}}
    <button class="link" bindtap="cancel">返回</button>
  </view>
</view>
