/* The result paper keeps the prototype's quiet system layout and an anchored action area. */
page {
  background: #f2f2f7;
}
.share-page {
  min-height: calc(100vh - var(--nav-height));
  box-sizing: border-box;
  padding-bottom: calc(172px + env(safe-area-inset-bottom));
}
.share-body {
  padding: 14px 28px 0;
}
.share-paper {
  display: block;
  width: 100%;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 12px 32px #29244110;
}
.share-placeholder {
  min-height: 380px;
  border-radius: 18px;
  background: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  box-sizing: border-box;
  color: #6b6b73;
  font-size: 14px;
  text-align: center;
}
.retry {
  margin-top: 16px;
  min-height: 44px;
  background: none;
  color: #285cdd;
  font-size: 15px;
}
.caption,
.compatibility {
  display: block;
  color: #6b6b73;
  font-size: 12px;
  line-height: 1.6;
  text-align: center;
}
.caption {
  margin: 10px 0 14px;
}
.share-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 10px 24px calc(18px + env(safe-area-inset-bottom));
  background: #f2f2f7;
}
.share-primary,
.share-save {
  min-height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  font-size: 16px;
  font-weight: 600;
}
.share-primary {
  background: var(--accent);
  color: white;
}
/* Explicit scoped widths override style:v2's default button sizing in the native renderer. */
.share-actions .share-primary,
.share-actions .share-save {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
}
.share-actions .share-primary[disabled] {
  background: var(--accent);
  color: white;
  opacity: 0.45;
}
.share-save {
  min-height: 44px;
  background: none;
  color: #285cdd;
  font-size: 15px;
  font-weight: 400;
  margin-top: 4px;
}
.share-primary::after,
.share-save::after,
.retry::after {
  border: 0;
}
.compatibility {
  font-size: 11px;
}
.poster-buffer {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 300px;
  height: 400px;
  pointer-events: none;
}
