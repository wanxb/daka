/* Shared generated stops cover every project theme without per-page palette drift. */
@import 'appearance.wxss';
@import 'motion.wxss';
/* System tokens follow the approved light iPhone direction; the first release has no dark theme. */
page {
  --ink: #1c1c1e;
  --secondary: #6b6b73;
  --accent: #6745c6;
  --surface: #fff;
  --line: #e6e6ec;
  --danger: #b42318;
  background: #f2f2f7;
  color: var(--ink);
  font-family:
    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 16px;
  line-height: 1.45;
}
button {
  box-sizing: border-box;
  font: inherit;
  margin: 0;
  padding: 0;
  border-radius: 0;
}
button::after {
  border: 0;
}
input,
textarea {
  font: inherit;
  box-sizing: border-box;
}
.page-content {
  max-width: 680px;
  margin: 0 auto;
  padding: 0 16px max(36px, env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.pressed {
  opacity: 0.65;
}
.secondary {
  color: var(--secondary);
}
.section-label {
  font-size: 12px;
  color: var(--secondary);
  margin: 22px 5px 9px;
}
.surface {
  background: var(--surface);
  border-radius: 17px;
  overflow: hidden;
}
.error {
  font-size: 14px;
  line-height: 1.5;
  color: var(--danger);
  padding: 12px 2px;
  word-break: break-all;
}
.primary {
  min-height: 50px;
  padding: 12px 20px;
  border-radius: 14px;
  background: var(--accent);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  line-height: 26px;
}
.primary[disabled] {
  opacity: 0.45;
  color: #fff;
  background: var(--accent);
}
.empty {
  padding: 40px 16px;
  color: var(--secondary);
  font-size: 15px;
  text-align: center;
  line-height: 1.6;
}
.link {
  color: var(--accent);
  background: transparent;
  min-height: 44px;
  line-height: 44px;
  padding: 0 12px;
  font-size: 14px;
}
/* Visible segmented pills are 28/32px high while their transparent hit areas remain 44px. */
.segments {
  display: flex;
  gap: 4px;
  align-items: center;
}
.segment-hit {
  flex: 1;
  background: none;
  min-width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.segment {
  /* WXML text preserves source line breaks; short control labels must remain a single visible line. */
  white-space: nowrap;
  width: 100%;
  height: 28px;
  line-height: 28px;
  border-radius: 7px;
  color: var(--secondary);
  background: #f0eef6;
  text-align: center;
  font-size: 12px;
  padding: 0 8px;
  box-sizing: border-box;
}
.segment.selected {
  color: #fff;
  background: var(--accent);
}
/* Paint-only feedback preserves native hit targets and avoids interfering with card drag transforms. */
button {
  transition: opacity 120ms ease-out;
}
.segment {
  transition:
    background-color 160ms ease-out,
    color 160ms ease-out;
}
@media (prefers-reduced-motion: reduce) {
  button,
  .segment {
    transition: none;
  }
}

/* Export buffers are fixed outside the viewport so native layers cannot cover navigation or records. */
.share-buffer {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 300px;
  height: 400px;
  pointer-events: none;
}
