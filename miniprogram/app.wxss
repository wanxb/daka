/* System tokens follow the approved light iPhone direction; the first release has no dark theme. */
page {
  --ink: #1c1c1e;
  --secondary: #696971;
  --accent: #6745c6;
  --surface: #fff;
  --line: #ededf2;
  --danger: #c52e3d;
  background: #f2f2f7;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-size: 16px;
  line-height: 1.45;
}
button {
  box-sizing: border-box;
  font: inherit;
  margin: 0;
  padding: 0;
  border-radius: 0;
}
button::after {
  border: 0;
}
input,
textarea {
  font: inherit;
  box-sizing: border-box;
}
.page-content {
  max-width: 680px;
  margin: 0 auto;
  padding: 12px 20px calc(40px + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.pressed {
  opacity: 0.65;
}
.secondary {
  color: var(--secondary);
}
.section-label {
  font-size: 13px;
  color: var(--secondary);
  margin: 24px 14px 8px;
}
.surface {
  background: var(--surface);
  border-radius: 16px;
  overflow: hidden;
}
.error {
  font-size: 14px;
  line-height: 1.5;
  color: var(--danger);
  padding: 12px 2px;
  word-break: break-all;
}
.primary {
  min-height: 50px;
  padding: 12px 20px;
  border-radius: 14px;
  background: var(--accent);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  line-height: 26px;
}
.primary[disabled] {
  opacity: 0.45;
  color: #fff;
  background: var(--accent);
}
.empty {
  padding: 40px 16px;
  color: var(--secondary);
  font-size: 15px;
  text-align: center;
  line-height: 1.6;
}
.link {
  color: var(--accent);
  background: transparent;
  min-height: 44px;
  line-height: 44px;
  padding: 0 12px;
  font-size: 14px;
}
/* Visible segmented pills are 28/32px high while their transparent hit areas remain 44px. */
.segments {
  display: flex;
  gap: 4px;
  align-items: center;
}
.segment-hit {
  flex: 1;
  background: none;
  min-width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.segment {
  /* WXML text preserves source line breaks; short control labels must remain a single visible line. */
  white-space: nowrap;
  width: 100%;
  height: 28px;
  line-height: 28px;
  border-radius: 7px;
  color: var(--secondary);
  background: #f0eef6;
  text-align: center;
  font-size: 13px;
  padding: 0 8px;
  box-sizing: border-box;
}
.segment.selected {
  color: #fff;
  background: var(--accent);
}
