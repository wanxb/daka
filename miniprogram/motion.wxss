/* Shared timing keeps action feedback consistent; animate paint/compositing, never slider values or layout. */
.motion-disclosure {
  animation: disclosure-in 180ms cubic-bezier(0.22, 0.8, 0.3, 1);
}
@keyframes disclosure-in {
  from {
    opacity: 0;
    transform: translateY(-4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
/* New content is immediately usable when motion is reduced; no animation is required to commit state. */
@media (prefers-reduced-motion: reduce) {
  .motion-disclosure {
    animation: none;
  }
}
