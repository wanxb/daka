/* A quiet, safe-area-aware confirmation leaves the main page fully usable. */
.toast {
  position: fixed;
  z-index: 30;
  bottom: calc(18px + env(safe-area-inset-bottom));
  left: 20px;
  right: 20px;
  background: #29292eef;
  color: #fff;
  border-radius: 16px;
  min-height: 52px;
  padding: 4px 8px 4px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-sizing: border-box;
  box-shadow: 0 6px 24px #00000015;
}
.message {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  line-height: 1.4;
}
.toast .undo {
  /* Explicit auto width beats style:v2's fixed button width, leaving room for the saved amount. */
  width: auto;
  flex-shrink: 0;
  background: none;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  min-height: 44px;
  padding: 0 12px;
  margin: 0;
  line-height: 44px;
}
.undo::after {
  border: 0;
}
/* Executing undo disables repeat taps; override style:v2's white disabled surface without losing that guard. */
.toast .undo[disabled] {
  background: transparent;
  color: #fff;
  opacity: 0.65;
}
/* A compact visible frame stays inside the transparent 44px target; it must not enlarge the toast. */
.toast .undo {
  position: relative;
  isolation: isolate;
  min-width: 52px;
  padding: 0 10px;
  border-radius: 8px;
}
.undo::before {
  content: '';
  position: absolute;
  z-index: -1;
  inset: 8px 2px;
  border: 1px solid #ffffff55;
  border-radius: 7px;
  background: #ffffff16;
  pointer-events: none;
}
.pressed {
  opacity: 0.6;
}
/* Keep both actions compact while preserving each button's established 44px touch surface. */
.actions {
  display: flex;
  flex-shrink: 0;
  gap: 2px;
}
/* Confirmation appears only after persistence; CSS never extends the authoritative undo deadline. */
.toast {
  animation: confirmation-in 220ms cubic-bezier(0.22, 0.8, 0.3, 1);
}
.undo {
  transition: opacity 120ms ease-out;
}
@keyframes confirmation-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@media (prefers-reduced-motion: reduce) {
  .toast {
    animation: none;
  }
  .undo {
    transition: none;
  }
}
