/* Components isolate styles, so disclosure rules must be imported here as well as on pages. */
@import '../../motion.wxss';
/* Match the approved 398px dual-metric sheet; native controls retain 44px hit areas and safe-area clearance. */
.sheet-scroll {
  max-height: 91vh;
  background: #fafafd;
  border-radius: 30px 30px 0 0;
}
.sheet {
  padding: 0 22px max(31px, env(safe-area-inset-bottom));
  color: #1c1c1e;
  font-family:
    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
.sheet button {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  border: 0;
  background: none;
  border-radius: 0;
  font-weight: 400;
}
.sheet button::after {
  border: 0;
}
.handle {
  height: 5px;
  width: 34px;
  border-radius: 4px;
  background: #d0cfd8;
  margin: 9px auto 12px;
}
.heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  height: 44px;
  margin-bottom: 12px;
}
.title {
  font-size: 23px;
  font-weight: 650;
  line-height: 1.2;
  letter-spacing: -0.5px;
  overflow-wrap: anywhere;
}
.metric {
  min-height: 80px;
  margin: 0 0 10px;
}
.field-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 36px;
  gap: 12px;
}
.field-label {
  font-size: 14px;
  font-weight: 400;
  color: #696271;
  flex: none;
}
.field-top .value {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 4px;
  width: auto;
  min-height: 44px;
  min-width: 44px;
  flex: none;
  margin-left: auto;
  color: #1c1c1e;
  white-space: nowrap;
  line-height: 36px;
}
.number {
  font-size: 25px;
  font-weight: 600;
  letter-spacing: -0.6px;
  font-variant-numeric: tabular-nums;
}
.unit {
  font-size: 12px;
  font-weight: 400;
  color: #6b6b73;
}
.value.is-disabled {
  color: #9c95a4;
}
.slider-row {
  position: relative;
  height: 44px;
}
/* Painting a 4px rail avoids platform-dependent native track thickness without replacing gesture handling. */
.slider-track {
  position: absolute;
  left: 0;
  right: 0;
  top: 23px;
  height: 4px;
  border-radius: 4px;
  background: #dedbe5;
  pointer-events: none;
  overflow: hidden;
}
.slider-fill {
  height: 100%;
  background: var(--accent);
  border-radius: 4px;
}
.slider-row.is-disabled {
  opacity: 0.45;
}
.slider {
  margin: 0;
  height: 44px;
  /* The native rail sits near the host's top; align it to the prototype's centered 44px touch row. */
  transform: translateY(16px);
}
.exact-value {
  flex: 1;
  min-width: 0;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
}
.exact {
  flex: 1;
  min-width: 0;
  height: 44px;
  text-align: right;
  font-size: 25px;
  font-weight: 600;
  letter-spacing: -0.6px;
  color: #1c1c1e;
  background: none;
  border: 0;
  font-variant-numeric: tabular-nums;
}
.tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  min-height: 44px;
}
.sheet .note-toggle {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 7px;
  width: auto;
  flex: 1;
  min-width: 44px;
  min-height: 44px;
  color: #8c8495;
  font-size: 12px;
  text-align: left;
}
.sheet .date-toggle {
  width: auto;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  margin-left: auto;
  flex: none;
  color: #6b6b73;
  font-size: 12px;
  white-space: nowrap;
}
.date-chevron {
  display: flex;
  transform: rotate(90deg);
}
.date-chevron.open {
  transform: rotate(270deg);
}
.date-fields {
  margin-bottom: 12px;
}
.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48px;
  border-top: 1px solid #e7e6ed;
  font-size: 14px;
  gap: 15px;
}
.date-value {
  color: var(--accent);
}
.time-row {
  display: flex;
  align-items: center;
}
.time-picker {
  flex: 1;
  min-width: 0;
}
.sheet .clear-time {
  width: 44px;
  min-width: 44px;
  height: 48px;
  flex: 0 0 44px;
  border-top: 1px solid #e7e6ed;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet .expanded-note {
  width: 100%;
}
.note {
  /* Keep the sheet stable during disclosure and typing; longer notes scroll inside the native input. */
  display: block;
  width: 100%;
  height: 68px;
  padding: 12px;
  border: 1px solid #e0dfe8;
  border-radius: 12px;
  background: #fff;
  box-sizing: border-box;
  font-size: 13px;
  line-height: 1.6;
  color: #1c1c1e;
  margin-bottom: 4px;
}
.note-count {
  color: #8c8495;
  font-size: 11px;
  line-height: 16px;
  text-align: right;
  margin: 0 2px 8px;
}
.note-count.at-limit {
  color: #6b6b73;
}
.sheet .save {
  width: 100%;
  height: 48px;
  min-height: 48px;
  margin-top: 13px;
  border-radius: 14px;
  background: var(--accent);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  line-height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet .save.is-disabled {
  opacity: 0.5;
  background: var(--accent);
  color: #fff;
}
.sheet .delete-record {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  min-height: 44px;
  margin-top: 7px;
  color: #b42318;
  font-size: 14px;
  line-height: 44px;
}
.error,
.field-error {
  font-size: 12px;
  line-height: 1.5;
  color: #b42318;
  margin: 10px 0 0;
}
.pressed {
  opacity: 0.65;
}
/* Native page-container owns entry/exit; only its internal controls receive lightweight feedback. */
.sheet button {
  transition: opacity 120ms ease-out;
}
.date-chevron {
  transition: transform 180ms cubic-bezier(0.22, 0.8, 0.3, 1);
}
@media (prefers-reduced-motion: reduce) {
  .sheet button,
  .date-chevron {
    transition: none;
  }
}
