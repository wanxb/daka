/* The visible chevron stays small; its touch target remains at least 44px. */
.navigation {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 17px;
  font-weight: 600;
}
.back {
  position: absolute;
  left: 8px;
  top: 0;
  width: 44px;
  height: 100%;
  min-height: 44px;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #007aff;
  font-size: 32px;
  line-height: 1;
}
.back::after {
  border: 0;
}

/* Sticky navigation also protects status/capsule space when long history scrolls beneath it. */
:host {
  display: block;
  position: sticky;
  top: 0;
  z-index: 20;
  background: #f2f2f7;
}
