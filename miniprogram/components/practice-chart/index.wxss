/* Reserve the tooltip line so inspecting a point never shifts the page or the chart. */
.chart-wrap {
  position: relative;
  padding-top: 40px;
}
.reading {
  position: absolute;
  left: 12px;
  right: 12px;
  top: 2px;
  min-height: 22px;
  text-align: center;
  color: #4d465e;
  font-size: 13px;
  line-height: 18px;
}
.chart {
  display: block;
  width: 100%;
  height: 200px;
}
.empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 112px;
  text-align: center;
  color: #696971;
  font-size: 14px;
  pointer-events: none;
}

/* Two tooltip lines keep a full date and exact amount readable without covering the plot. */
.reading {
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}
