/* Fill the shared statistics body; only the optional readout retains a fixed height. */
.chart-wrap {
  position: relative;
  /* The image surface shares ordinary page stacking with the opaque fixed navigation. */
  z-index: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}
.reading-slot {
  display: flex;
  align-items: center;
  gap: 8px;
  /* The page-level folded corner reserves the right edge without adding a footer row. */
  padding-right: 46px;
  flex-shrink: 0;
  height: 24px;
  padding-top: 4px;
  box-sizing: border-box;
}
.reading {
  flex: 1;
  min-width: 0;
  color: #6b6b73;
  font-size: 12px;
  line-height: 20px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-variant-numeric: tabular-nums;
}
.chart {
  display: block;
  width: 100%;
  flex: 1;
  min-height: 0;
}
.chart-image {
  display: block;
  width: 100%;
  height: 100%;
}
/* No native drawing surface may scroll into the toolbar or the record sheet. Its backing pixels still use full DPR. */
.chart-buffer {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 1px;
  height: 1px;
  pointer-events: none;
}
.empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 44%;
  text-align: center;
  color: #6b6b73;
  font-size: 13px;
  pointer-events: none;
}
