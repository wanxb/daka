<!-- Readings appear only after a deliberate touch, leaving the default chart free of explanatory copy. -->
<view class="chart-wrap">
  <view class="reading" aria-live="polite">{{reading}}</view>
  <canvas
    id="chart"
    type="2d"
    class="chart"
    bindtouchstart="startTouch"
    bindtouchend="endTouch"
    bindtouchcancel="cancelTouch"
    aria-label="{{mode === 'cumulative'?'累计曲线':'分布图'}}，单位{{unit}}"
  />
  <view wx:if="{{empty}}" class="empty">
    {{mode==='distribution'?'本期还没有记录':'还没有记录'}}
  </view>
</view>
