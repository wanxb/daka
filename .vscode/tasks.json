{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "愚公打卡：本地检查",
      "type": "shell",
      "command": "npm",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "args": ["run", "check"],
      "windows": {
        "command": "npm.cmd"
      }
    },
    {
      "label": "微信：检查连接",
      "type": "shell",
      "command": "npm",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "args": ["run", "devtools:status"],
      "windows": {
        "command": "npm.cmd"
      }
    },
    {
      "label": "微信：打开真实小程序",
      "type": "shell",
      "command": "npm",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "微信：检查连接",
      "problemMatcher": [],
      "args": ["run", "devtools:open"],
      "windows": {
        "command": "npm.cmd"
      }
    },
    {
      "label": "微信：重新编译",
      "type": "shell",
      "command": "npm",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "微信：检查连接",
      "problemMatcher": [],
      "args": ["run", "devtools:refresh"],
      "windows": {
        "command": "npm.cmd"
      }
    },
    {
      "label": "愚公打卡：原型服务（仅浏览器设计稿）",
      "type": "shell",
      "command": "npm",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "prototype",
        "pattern": {
          "regexp": "^(scripts/preview-prototype\\.mjs): (.+)$",
          "file": 1,
          "message": 2,
          "kind": "file"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting prototype preview",
          "endsPattern": "^PROTOTYPE_READY "
        }
      },
      "args": ["run", "preview:prototype"],
      "windows": {
        "command": "npm.cmd"
      }
    }
  ]
}
